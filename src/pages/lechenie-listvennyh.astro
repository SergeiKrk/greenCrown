---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/blocks/hero/PageHero.astro'
import SidebarContent from '../components/blocks/basic/StickySidebar.astro'
import FAQ from '../components/blocks/FAQ/FaqSticky.astro'
import TextImage from '../components/blocks/basic/TextImage.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'
import FormOption from '../components/ui/forms/form-option/FormOption.jsx'
import Feature from '../components/ui/Feature.astro'
import Steps from '../components/ui/Steps.astro'
import ImageGallery from '../components/ui/ImageGallery.astro'

import heroImg from '../assets/highlights/listvennie-derevya.png'

import Grut from '../assets/Grut.webp'
import faqData from '../data/json-files/faqData.json'
import features from '../data/json-files/featuresData.json'
const faqIntegrations = faqData.filter((faq) => faq.category === 'lechenie-listvennyh')

// Content
import faqImage1 from '../assets/sezonnaya-obrabotka-derevev.jpg'
import ll1 from '../assets/lechenie-listvennyh-porod-derevev-1.jpg'
import ll2 from '../assets/lechenie-listvennyh-porod-derevev-2.jpg'
import ll3 from '../assets/lechenie-listvennyh-porod-derevev-3.jpg'
import ll4 from '../assets/lechenie-listvennyh-porod-derevev-4.jpg'
import { Image } from 'astro:assets'
// - SEO
const SEO = {
	title: 'Лечение лиственных деревьев: методы, профилактика и уход',
	description:
		'Узнайте цены на лечение лиственных деревьев. Профессиональная диагностика, обработка и защита от болезней. Сезонная обработка для здоровья и долголетия ваших растений.'
}
// - Page Header
const header = {
	title: 'Лечение <strong>лиственных</strong> деревьев',
	text: 'Профессиональное лечение лиственных деревьев от болезней и вредителей.'
}

type steps = {
	title: string
	text: string
}
const steps: steps[] = [
	{
		title: 'Диагностика состояния',
		text: 'Наши специалисты осматривают деревья, определяют болезни или вредителей и оценивают общее состояние растений.'
	},
	{
		title: 'План лечения',
		text: 'Разрабатываем индивидуальную программу обработки – выбор препаратов, методов лечения и графика работ.'
	},
	{
		title: 'Обработка и восстановление',
		text: 'Проводим опрыскивание, обработку корневой зоны или другие мероприятия в зависимости от выявленных проблем.'
	}
]
const endstep = {
	title: 'Профилактика',
	text: 'Устанавливаем защиту от вредителей и болезней, чтобы ваши растения оставались здоровыми круглый год.'
}
const images = [
	{
		src: ll1,
		alt: 'Лечение лиственных пород деревьев'
	},
	{
		src: ll2,
		alt: 'Лечение хвойных лиственных деревьев на участке'
	},
	{
		src: ll3,
		alt: 'Лечение хвойных лиственных пород в парке'
	},
	{
		src: ll4,
		alt: 'Профессиональное Лечение лиственных деревьев'
	}
]
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} heroImg={heroImg} />
	<section
		class="mt-42 mx-auto mb-6 max-w-[1200px] bg-neutral-100/80 p-6 2xl:my-24 2xl:bg-white dark:bg-neutral-900"
		aria-multiselectable="false"
	>
		<div class="md:flex md:flex-row">
			<div class="text-slate-500 dark:text-slate-300">
				<div class="relative p-6 pb-0 pr-0">
					<figure class="relative z-10">
						<blockquote class="p-6 leading-relaxed">
							<p class="mb-2 text-sm font-light">
								<i>
									Лечить лиственные деревья – значит не просто устранить симптомы, а восстановить их
									здоровье и силу. Мы предоставляем услуги по диагностике, лечению и профилактике
									заболеваний деревьев, чтобы ваши зеленые насаждения радовали глаз и оставались
									частью живой экосистемы.</i
								>
							</p>
							<p class="mt-1">
								<span class="font-bold">Закажите бесплатную консультацию</span> и мы поможем сохранить
								здоровье и красоту ваших лиственных растений.
							</p>
						</blockquote>
					</figure><svg
						aria-hidden="true"
						class="absolute left-6 top-6 z-0 h-16 dark:hidden"
						viewBox="0 0 17 12"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						><path
							d="M2.79187 3.83333C2.66179 3.83333 2.53696 3.85316 2.41271 3.87125C2.45296 3.73591 2.49437 3.59825 2.56087 3.47458C2.62737 3.29491 2.73121 3.13916 2.83446 2.98225C2.92079 2.8125 3.07304 2.69758 3.18504 2.55233C3.30229 2.41116 3.46212 2.31725 3.58871 2.2C3.71296 2.0775 3.87571 2.01625 4.00521 1.92991C4.14054 1.85233 4.25837 1.76658 4.38437 1.72575L4.69879 1.59625L4.97529 1.48133L4.69237 0.35083L4.34412 0.43483C4.23271 0.46283 4.09679 0.495496 3.94221 0.53458C3.78412 0.563746 3.61554 0.643663 3.42771 0.71658C3.24221 0.799413 3.02754 0.855413 2.82804 0.988413C2.62737 1.11558 2.39579 1.22175 2.19162 1.39208C1.99387 1.56766 1.75529 1.71991 1.57912 1.94333C1.38662 2.15216 1.19646 2.3715 1.04887 2.62116C0.877957 2.85916 0.761873 3.1205 0.639373 3.37891C0.52854 3.63733 0.43929 3.90158 0.366373 4.15825C0.228123 4.67275 0.16629 5.16158 0.142373 5.57983C0.12254 5.99866 0.134207 6.34691 0.158707 6.59891C0.167457 6.71791 0.18379 6.83341 0.195457 6.91333L0.21004 7.01133L0.225207 7.00783C0.328959 7.49248 0.567801 7.93786 0.914102 8.29243C1.2604 8.64701 1.70001 8.89631 2.18208 9.01148C2.66415 9.12665 3.16897 9.10299 3.63815 8.94323C4.10733 8.78348 4.52169 8.49416 4.83331 8.10874C5.14493 7.72333 5.34107 7.25757 5.39903 6.76534C5.457 6.27311 5.37443 5.77452 5.16087 5.32726C4.94731 4.88 4.61149 4.50233 4.19225 4.23796C3.77302 3.97358 3.28751 3.8333 2.79187 3.83333V3.83333ZM9.20854 3.83333C9.07846 3.83333 8.95362 3.85316 8.82937 3.87125C8.86962 3.73591 8.91104 3.59825 8.97754 3.47458C9.04404 3.29491 9.14787 3.13916 9.25112 2.98225C9.33746 2.8125 9.48971 2.69758 9.60171 2.55233C9.71896 2.41116 9.87879 2.31725 10.0054 2.2C10.1296 2.0775 10.2924 2.01625 10.4219 1.92991C10.5572 1.85233 10.675 1.76658 10.801 1.72575L11.1155 1.59625L11.392 1.48133L11.109 0.35083L10.7608 0.43483C10.6494 0.46283 10.5135 0.495496 10.3589 0.53458C10.2008 0.563746 10.0322 0.643663 9.84437 0.71658C9.65946 0.799997 9.44421 0.855413 9.24471 0.988997C9.04404 1.11616 8.81246 1.22233 8.60829 1.39266C8.41054 1.56825 8.17196 1.7205 7.99579 1.94333C7.80329 2.15216 7.61312 2.3715 7.46554 2.62116C7.29462 2.85916 7.17854 3.1205 7.05604 3.37891C6.94521 3.63733 6.85596 3.90158 6.78304 4.15825C6.64479 4.67275 6.58296 5.16158 6.55904 5.57983C6.53921 5.99866 6.55087 6.34691 6.57537 6.59891C6.58412 6.71791 6.60046 6.83341 6.61212 6.91333L6.62671 7.01133L6.64187 7.00783C6.74563 7.49248 6.98447 7.93786 7.33077 8.29243C7.67707 8.64701 8.11668 8.89631 8.59875 9.01148C9.08081 9.12665 9.58563 9.10299 10.0548 8.94323C10.524 8.78348 10.9384 8.49416 11.25 8.10874C11.5616 7.72333 11.7577 7.25757 11.8157 6.76534C11.8737 6.27311 11.7911 5.77452 11.5775 5.32726C11.364 4.88 11.0282 4.50233 10.6089 4.23796C10.1897 3.97358 9.70417 3.8333 9.20854 3.83333V3.83333Z"
							class="fill-emerald-100"></path></svg
					>
				</div>
			</div>
			<div class="group flex">
				<div
					class="animate__animated animate__rubberBand z-10 block rounded-md px-8 py-4 pr-6 md:border-r-8 md:border-[#2FAF83] md:bg-neutral-50 2xl:w-[600px] dark:bg-neutral-800"
				>
					<FormOption idForm="1" titleForm={SEO.title} client:load />
				</div>
				<Image
					class="hidden -translate-x-16 transition delay-150 duration-700 ease-in-out group-hover:translate-x-0 md:block"
					src={Grut}
					alt="grut"
					height={Grut.width / 2}
					width={Grut.height / 2}
				/>
			</div>
		</div>
	</section>
	<SidebarContent classes="bg-neutral-50 dark:bg-neutral-900">
		<div slot="sidebar">
			<h2 class="lg:text-2xl">Проблемы лиственных деревьев и их решение</h2>

			<a
				href="#"
				class="inline-flex h-8 items-center justify-center gap-2 whitespace-nowrap rounded border border-emerald-500 px-4 text-xs font-medium tracking-wide text-emerald-500 transition duration-300 hover:border-emerald-600 hover:text-emerald-600 focus:border-emerald-700 focus:text-emerald-700 focus-visible:outline-none disabled:cursor-not-allowed disabled:border-emerald-300 disabled:text-emerald-300 disabled:shadow-none"
			>
				<span>Заказать консультацию</span>
			</a>
		</div>
		<div class="basic-text">
			<p>
				Лиственные деревья страдают от гнили, ржавчины, некроза, паразитов, грибковых заболеваний.
				Возбудители проникают через кору, распространяясь внутри дерева. Среди болезней
				распространены опухолевые патологии, схожие с микозами, а также неинфекционные заболевания,
				вызванные нехваткой влаги, питательных веществ или повреждениями.
			</p>
			<p>
				В списке болезни лиственных деревьев преобладают опухолевые патологии. Они схожи с микозами,
				вот почему многие садоводы их путают. Наросты появляются на здоровых тканях из-за
				неправильного размножения клеток. Причиной являются и ранее перенесенные грибковые и
				инфекционные недуги. Как лечить рак на деревьях? Далее рассмотрим этот вопрос.
			</p>
			<p>
				Неинфекционные заболевания происходят по разным причинам, среди которых нехватка влаги и
				питательных компонентов, механические повреждения коры, неблагоприятные погодные условия.
				Как лечить лиственные деревья? Перед этим обязательно проводится диагностика, позволяющая
				точно установить характер недуга.
			</p>
		</div>
	</SidebarContent>
	<SidebarContent>
		<div slot="sidebar">
			<h2 class="lg:text-2xl">Методы лечения лиственных деревьев</h2>
			<p>
				Запишитесь на лечение лиственных растений уже сегодня! Ваши деревья снова станут здоровыми.
			</p>
			<a
				href="#"
				class="inline-flex h-8 items-center justify-center gap-2 whitespace-nowrap rounded border border-emerald-500 px-4 text-xs font-medium tracking-wide text-emerald-500 transition duration-300 hover:border-emerald-600 hover:text-emerald-600 focus:border-emerald-700 focus:text-emerald-700 focus-visible:outline-none disabled:cursor-not-allowed disabled:border-emerald-300 disabled:text-emerald-300 disabled:shadow-none"
			>
				<span>Записаться</span>
			</a>
		</div>
		<div class="basic-text">
			<h3 class="lg:text-2xl">Стволовые инъекции</h3>
			<p>
				Ими не только лечат кору деревьев, но борются с паразитами, с инфекционными и грибковыми
				болезнями. Также препараты для лечения лиственных деревьев обеспечивают полноценное питание
				пересадке.
			</p>
			<h3 class="lg:text-2xl">Капельницы для лиственных деревьев</h3>
			<p>
				Они предназначены для введения веществ и питательных компонентов путем прямых уколов в
				сосудистую систему растения. Принцип аналогичен капельнице для человека: лекарство быстрее
				проникает в ткани, а побочки минимальны.
			</p>
			<h3 class="lg:text-2xl">Обработка биопрепаратами</h3>
			<p>
				Различные болезни легко передаются через почву. Эту проблему устраняют фугнициды,
				уничтожающие возбудителей и препятствующие распространению заболеваний. Фитодоктор 20 г –
				эффективный биологический препарат, который помогает в борьбе с разными болезнями.
			</p>
		</div>
	</SidebarContent>
	<TextImage
		title="Сезонная обработка деревьев"
		text="<p>Первая обработка растений происходит еще до распускания листьев, чтобы вредители, живущие в почках и в коре, уничтожились, не проснувшись. Далее рекомендуется опрыскивание  каждые 3-4 недели до завершения листопада. Весенняя обработка лиственных деревьев обычно проводится в первой декаде апреля. В это время культуры обрабатываются от парши, мучнистой росы, пятнистости, медяницы, листоверток, тлей.</p><p>Как лечить деревья летом? Процедуру проводят в июне, через 3 недели после предыдущего мероприятия. Деревья защищают от шютте, пурпуровой пятнистости, тли. Осенняя обработка лиственных деревьев проводится в конце августа. В это время растения обрабатывают против ржавчинных грибов лекарством «Хом». Зимняя защита лиственных деревьев выполняется после листопада. В это время процедура проводится от болезней стволов и ветвей.</p>"
		image={faqImage1}
		mobileImage={faqImage1}
		imagePosition="left"
		offsetImage
		classes="bg-neutral-50 dark:bg-neutral-900 lg:!py-32"
	/>
	<SidebarContent>
		<div slot="sidebar">
			<h2 class="lg:text-2xl">Как мы возвращаем здоровье лиственным растениям: шаг за шагом</h2>
			<p>
				Мы разработали четкий и проверенный алгоритм лечения лиственных деревьев и кустарников,
				чтобы гарантировать их восстановление и защиту.
			</p>
			<p class="mt-4">
				<i
					>Хотите, чтобы ваши растения снова радовали глаз? Оставьте заявку, и мы проведем
					диагностику уже в ближайшее время!</i
				>
			</p>
			<a
				href="#"
				class="inline-flex h-8 items-center justify-center gap-2 whitespace-nowrap rounded border border-emerald-500 px-4 text-xs font-medium tracking-wide text-emerald-500 transition duration-300 hover:border-emerald-600 hover:text-emerald-600 focus:border-emerald-700 focus:text-emerald-700 focus-visible:outline-none disabled:cursor-not-allowed disabled:border-emerald-300 disabled:text-emerald-300 disabled:shadow-none"
			>
				<span>Оставить заявку</span>
			</a>
		</div>
		<div class="basic-text lg:ml-4">
			<h3 class="lg:text-2xl">Этапы работы:</h3>
			<Steps steps={steps} endstep={endstep} />
		</div>
	</SidebarContent>
	<SidebarContent classes="bg-neutral-50 dark:bg-neutral-900">
		<div slot="sidebar">
			<h2 class="lg:text-2xl">Диагностика заболеваний лиственных деревьев</h2>
			<p>
				Включает оценку состояния дерева, выявление проблемы, причины и возбудителя. Используются
				макроскопический, микроскопический и биологический методы диагностики.
			</p>
			<a
				href="#"
				class="inline-flex h-8 items-center justify-center gap-2 whitespace-nowrap rounded border border-emerald-500 px-4 text-xs font-medium tracking-wide text-emerald-500 transition duration-300 hover:border-emerald-600 hover:text-emerald-600 focus:border-emerald-700 focus:text-emerald-700 focus-visible:outline-none disabled:cursor-not-allowed disabled:border-emerald-300 disabled:text-emerald-300 disabled:shadow-none"
			>
				<span>Заказать диагностику</span>
			</a>
		</div>
		<div class="basic-text">
			<h3 class="lg:text-2xl">Профилактика и уход за лиственными деревьями</h3>
			<p>
				Уход за лиственными деревьями проводят весной и в первой половине лета. В это время
				посадочный материал нужно подкормить удобрениями с высоким содержанием азота. А со второй
				половины лета для удобрения используется фосфор и калий. Они помогают эффективному
				вызреванию молодых побегов, укреплению корней. Профилактика болезней лиственных деревьев
				должна проводиться регулярно.
			</p>
		</div>
	</SidebarContent>
	<SidebarContent>
		<div slot="sidebar">
			<h2 class="lg:text-2xl">Цены на лечение лиственных</h2>
			<p>
				Узнайте стоимость услуг по лечению лиственных деревьев: цена зависит от объема работ и
				состояния растений.
			</p>
		</div>
		<div class="basic-text">
			<div class="w-full overflow-x-auto">
				<table
					class="w-full border-separate rounded border border-slate-200 text-left"
					cellspacing="0"
				>
					<tbody>
						<tr>
							<th
								scope="col"
								class="h-12 border-l bg-slate-100 stroke-slate-700 px-6 text-sm font-medium text-slate-700 first:border-l-0"
								>Name</th
							>
							<th
								scope="col"
								class="h-12 border-l bg-slate-100 stroke-slate-700 px-6 text-sm font-medium text-slate-700 first:border-l-0"
								>Title</th
							>
							<th
								scope="col"
								class="h-12 border-l bg-slate-100 stroke-slate-700 px-6 text-sm font-medium text-slate-700 first:border-l-0"
								>Company</th
							>
							<th
								scope="col"
								class="h-12 border-l bg-slate-100 stroke-slate-700 px-6 text-sm font-medium text-slate-700 first:border-l-0"
								>Role</th
							>
							<th
								scope="col"
								class="h-12 border-l bg-slate-100 stroke-slate-700 px-6 text-sm font-medium text-slate-700 first:border-l-0"
								>Username</th
							>
						</tr>
						<tr class="transition-colors duration-300 hover:bg-slate-50">
							<td
								class="h-12 border-l border-t border-slate-200 stroke-slate-500 px-6 text-sm text-slate-500 transition duration-300 first:border-l-0"
								>Ayub Salas</td
							>
							<td
								class="h-12 border-l border-t border-slate-200 stroke-slate-500 px-6 text-sm text-slate-500 transition duration-300 first:border-l-0"
								>Designer</td
							>
							<td
								class="h-12 border-l border-t border-slate-200 stroke-slate-500 px-6 text-sm text-slate-500 transition duration-300 first:border-l-0"
								>Carroll Group</td
							>
							<td
								class="h-12 border-l border-t border-slate-200 stroke-slate-500 px-6 text-sm text-slate-500 transition duration-300 first:border-l-0"
								>Member</td
							>
							<td
								class="h-12 border-l border-t border-slate-200 stroke-slate-500 px-6 text-sm text-slate-500 transition duration-300 first:border-l-0"
								>salas_a</td
							>
						</tr>
						<tr class="transition-colors duration-300 hover:bg-slate-50">
							<td
								class="h-12 border-l border-t border-slate-200 stroke-slate-500 px-6 text-sm text-slate-500 transition duration-300 first:border-l-0"
								>Agnes Sherman</td
							>
							<td
								class="h-12 border-l border-t border-slate-200 stroke-slate-500 px-6 text-sm text-slate-500 transition duration-300 first:border-l-0"
								>Developer</td
