---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHero.astro'
import SidebarContent from '../components/blocks/basic/StickySidebar.astro'
import FAQ from '../components/blocks/FAQ/FaqSticky.astro'
import TextImage from '../components/blocks/basic/TextImage.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'
import FormOption from '../components/ui/forms/form-option/FormOption.jsx'
import Feature from '../components/ui/Feature.astro'
import ImageGallery from '../components/ui/ImageGallery.astro'

import ll1 from '../assets/omolazhivayushchaya-obrezka-derevev-1.jpg'
import ll2 from '../assets/omolazhivayushchaya-obrezka-derevev-2.jpg'
import ll3 from '../assets/omolazhivayushchaya-obrezka-derevev-3.jpg'
import ll4 from '../assets/omolazhivayushchaya-obrezka-derevev-4.jpg'

import heroImg from '../assets/omolazhivayushchaya-obrezka.png'
import Grut from '../assets/Grut.webp'
// Data
import faqData from '../data/json-files/faqData.json'

import features from '../data/json-files/featuresData.json'
// - FAQ Categories
const faqIntegrations = faqData.filter((faq) => faq.category === 'omolazhivayushchaya-obrezka')

// Content
import obrabotkaNasekImg from '../assets/omolazhivayushchaya-obrezka-derevev-.jpg'
import { Image } from 'astro:assets'
import BtnLight from '../components/ui/BtnLight.astro'
import Steps from '../components/ui/Steps.astro'
// - SEO
const SEO = {
	title: 'Омолаживающая обрезка деревьев – Цены на услуги от 1500 руб.',
	description:
		'Профессиональная обрезка старых деревьев для восстановления их силы и красоты. Мы поможем улучшить здоровье и повысить урожайность.'
}
// - Page Header
const header = {
	title: '<strong>Омолаживающая</strong> обрезка старых деревьев и кустарников',
	text: 'Щадящая омолаживающая обрезка: сохраним здоровье растений на долгие годы'
}
type steps = {
	title: string
	text?: string
}
const steps: steps[] = [
	{
		title: 'Диагностика',
		text: 'Перед обрезкой оцениваем состояние дерева. Проверяем возраст, густоту кроны, наличие сухих и больных ветвей. Определяем, какие побеги нужно удалить, чтобы дерево получало больше света и питательных веществ.'
	},
	{
		title: 'Удаление старых ветвей',
		text: 'Срезаем сухие, ослабленные и загущающие ветки. Обрезку проводим аккуратно, чтобы не навредить дереву. После удаления кроне становится легче, улучшается циркуляция воздуха и доступ солнечного света.'
	},
	{
		title: 'Формирование кроны',
		text: 'Создаем правильную форму, оставляя сильные и перспективные побеги. Регулируем высоту, чтобы дерево могло питать все ветви. Улучшаем структуру кроны для равномерного распределения света.'
	}
]
const endstep = {
	title: 'Уход после обрезки',
	text: 'Обрабатываем срезы защитными средствами, подкармливаем дерево удобрениями, поливаем и мульчируем почву. Это помогает растению быстрее восстановиться и начать новый этап роста.'
}

const images = [
	{
		src: ll1,
		alt: 'Омолаживающая обрезка старых деревьев и кустарников'
	},
	{
		src: ll2,
		alt: 'Омолаживающая обрезка старых деревьев'
	},
	{
		src: ll3,
		alt: 'Омолаживающая обрезка деревьев'
	},
	{
		src: ll4,
		alt: 'Омолаживающая обрезка'
	}
]
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} heroImg={heroImg} />
	<section
		class="mt-42 mx-auto mb-6 max-w-[1200px] bg-neutral-100/80 p-6 2xl:my-24 2xl:bg-white dark:bg-neutral-900"
		aria-multiselectable="false"
	>
		<div class="md:flex md:flex-row">
			<div class="text-slate-500 dark:text-slate-300">
				<div class="relative p-6 pb-0 pr-0">
					<figure class="relative z-10">
						<blockquote class="p-6 leading-relaxed">
							<p class="mb-2 text-sm font-light">
								<i
									>Закажите профессиональную омолаживающую обрезку деревьев и кустарников, чтобы
									вернуть им здоровье и красивый вид!</i
								>
							</p>
							<p class="mt-1">
								<span class="font-bold">Закажите услугу сегодня</span> и получите план профилактических
								мер для вашего участка!
							</p>
						</blockquote>
					</figure><svg
						aria-hidden="true"
						class="absolute left-6 top-6 z-0 h-16 dark:hidden"
						viewBox="0 0 17 12"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
