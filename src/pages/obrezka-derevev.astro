---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/blocks/hero/PageHero.astro'
import Section from '../components/ui/Section.astro'
import Card from '../components/ui/cards/FeatureCard.astro'
import SidebarContent from '../components/blocks/basic/StickySidebar.astro'
import FAQ from '../components/blocks/FAQ/FaqSticky.astro'
import TextImage from '../components/blocks/basic/TextImage.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'
import FormOption from '../components/ui/forms/form-option/FormOption.jsx'
import Feature from '../components/ui/Feature.astro'
import ImageGallery from '../components/ui/ImageGallery.astro'

import heroImg from '../assets/obrezka-i-obrabotka-derevev.png'
import hvoinie from '../assets/highlights/hvoinie-derevya.png'
import plodovie from '../assets/highlights/lechenie-plodovyh.png'
import vysokiederevya from '../assets/vysokie-derevya.png'
import formovochnayaobrezka from '../assets/formovochnaya-obrezka.png'
import sanitarnayaobrezka from '../assets/sanitarnaya-obrezka.png'
import omolazhivayushchayaobrezka from '../assets/omolazhivayushchaya-obrezka.png'
import kronirovanie from '../assets/kronirovanie.png'

import Grut from '../assets/Grut.webp'
import faqData from '../data/json-files/faqData.json'
import features from '../data/json-files/featuresData.json'
const faqIntegrations = faqData.filter((faq) => faq.category === 'obrezka-derevev')

// Content
import faqImage1 from '../assets/vidy-obrezki-derevev.jpg'
import ll1 from '../assets/od1.jpg'
import ll2 from '../assets/od2.jpg'
import ll3 from '../assets/od3.jpg'
import ll4 from '../assets/od4.jpg'
import { Image } from 'astro:assets'
import BtnLight from '../components/ui/BtnLight.astro'
import FeaturesAddition from '../components/ui/FeaturesAddition.astro'
// - SEO
const SEO = {
	title: 'Обрезка деревьев и кустарников - Цена услуги в Москве и МО',
	description:
		'Профессиональная обрезка деревьев для улучшения роста, защиты от болезней и формирования красивой кроны. Бесплатная консультация и качественное обслуживание. Уход за вашими деревьями – наша забота!'
}
// - Page Header
const header = {
	title: '<strong>Обрезка</strong> деревьев и кустарников',
	text: 'Услуги по обрезке деревьев помогают улучшить здоровье растений, сформировать правильную крону и повысить урожайность.'
}

const catCards = {
	title: 'Услуги по <strong>обрезке</strong> деревьев и кустарников',
	description:
		'Работаем с плодовыми и декоративными растениями. Учитываем особенности каждого участка.'
}

type MajorSubCategories = {
	link: string
	title: string
	image: any
	imageWidth: number
	imageHeight: number
}

const MajorSubCategories: MajorSubCategories[] = [
	{
		link: '/formovochnaya-obrezka',
		title: 'Формовочная обрезка',
		image: formovochnayaobrezka,
		imageWidth: formovochnayaobrezka.width,
		imageHeight: formovochnayaobrezka.height
	},
	{
		link: '/sanitarnaya-obrezka',
		title: 'Санитарная обрезка',
		image: sanitarnayaobrezka,
		imageWidth: sanitarnayaobrezka.width,
		imageHeight: sanitarnayaobrezka.height
	},
	{
		link: '/omolazhivayushchaya-obrezka',
		title: 'Омолаживающая обрезка',
		image: omolazhivayushchayaobrezka,
		imageWidth: omolazhivayushchayaobrezka.width,
		imageHeight: omolazhivayushchayaobrezka.height
	},
	{
		link: '/kronirovanie',
		title: 'Кронирование',
		image: kronirovanie,
		imageWidth: kronirovanie.width,
		imageHeight: kronirovanie.height
	}
]

const featuresAddition = {
	title: 'Типы деревьев',
	text: 'Работы по которым мы проводим',
	additions: [
		{
			title: 'Плодовые деревья',
			text: 'Регулярная обрезка повышает урожайность, улучшает освещённость кроны и предотвращает развитие заболеваний. Важно удалять сухие, повреждённые и загущающие ветви, чтобы дерево тратило ресурсы на здоровый рост и плодоношение.',
			heroImg: plodovie
		},
		{
			title: 'Хвойные деревья',
			text: 'Их обрезают для формирования кроны, удаления сухих веток и предотвращения загущения. Процедуру проводят аккуратно, чтобы не повредить живые побеги, так как у многих хвойных слабая способность к восстановлению.',
			heroImg: hvoinie
		},
		{
			title: 'Молодые деревья',
			text: 'Формирующая обрезка молодых деревьев закладывает основу для правильного роста и здоровой кроны. В первые годы удаляют слабые и неправильно растущие ветви, чтобы дерево развивалось гармонично и было устойчивым к нагрузкам.',
			heroImg: kronirovanie
		},
		{
			title: 'Высокие деревья',
			text: 'Такая обрезка требует специального оборудования и опыта. Удаление сухих и аварийных веток снижает риск их падения, а формирование кроны помогает дереву сохранять устойчивость и здоровый рост.',
			heroImg: vysokiederevya
		}
	]
}

const images = [
	{
		src: ll1,
		alt: 'формовочная Обрезка деревьев'
	},
	{
		src: ll2,
		alt: 'формовочная Обрезка'
	},
	{
		src: ll3,
		alt: 'Обрезка деревьев'
	},
	{
		src: ll4,
		alt: 'Обрезка деревьев и кустарников'
	}
]
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} heroImg={heroImg} />
	<section
		class="mt-42 mx-auto mb-6 max-w-[1200px] bg-neutral-100/80 p-6 2xl:my-24 2xl:bg-white dark:bg-neutral-900"
		aria-multiselectable="false"
	>
		<div class="md:flex md:flex-row">
			<div class="text-slate-500 dark:text-slate-300">
				<div class="relative p-6 pb-0 pr-0">
					<figure class="relative z-10">
						<blockquote class="p-6 leading-relaxed">
							<p class="mb-2 text-sm font-light">
								<i>
									Обрезка деревьев – залог их здоровья и хорошего урожая. Она помогает улучшить
									форму и укрепить растения. Чтобы выбрать правильный подход, важно учитывать
									особенности каждого дерева.</i
								>
							</p>
							<p class="mt-1">
								<span class="font-bold">Закажите бесплатную консультацию</span>, и мы поможем
								обеспечить вашим деревьям здоровый рост и отличное плодоношение!
							</p>
						</blockquote>
					</figure><svg
						aria-hidden="true"
						class="absolute left-6 top-6 z-0 h-16 dark:hidden"
						viewBox="0 0 17 12"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						><path
							d="M2.79187 3.83333C2.66179 3.83333 2.53696 3.85316 2.41271 3.87125C2.45296 3.73591 2.49437 3.59825 2.56087 3.47458C2.62737 3.29491 2.73121 3.13916 2.83446 2.98225C2.92079 2.8125 3.07304 2.69758 3.18504 2.55233C3.30229 2.41116 3.46212 2.31725 3.58871 2.2C3.71296 2.0775 3.87571 2.01625 4.00521 1.92991C4.14054 1.85233 4.25837 1.76658 4.38437 1.72575L4.69879 1.59625L4.97529 1.48133L4.69237 0.35083L4.34412 0.43483C4.23271 0.46283 4.09679 0.495496 3.94221 0.53458C3.78412 0.563746 3.61554 0.643663 3.42771 0.71658C3.24221 0.799413 3.02754 0.855413 2.82804 0.988413C2.62737 1.11558 2.39579 1.22175 2.19162 1.39208C1.99387 1.56766 1.75529 1.71991 1.57912 1.94333C1.38662 2.15216 1.19646 2.3715 1.04887 2.62116C0.877957 2.85916 0.761873 3.1205 0.639373 3.37891C0.52854 3.63733 0.43929 3.90158 0.366373 4.15825C0.228123 4.67275 0.16629 5.16158 0.142373 5.57983C0.12254 5.99866 0.134207 6.34691 0.158707 6.59891C0.167457 6.71791 0.18379 6.83341 0.195457 6.91333L0.21004 7.01133L0.225207 7.00783C0.328959 7.49248 0.567801 7.93786 0.914102 8.29243C1.2604 8.64701 1.70001 8.89631 2.18208 9.01148C2.66415 9.12665 3.16897 9.10299 3.63815 8.94323C4.10733 8.78348 4.52169 8.49416 4.83331 8.10874C5.14493 7.72333 5.34107 7.25757 5.39903 6.76534C5.457 6.27311 5.37443 5.77452 5.16087 5.32726C4.94731 4.88 4.61149 4.50233 4.19225 4.23796C3.77302 3.97358 3.28751 3.8333 2.79187 3.83333V3.83333ZM9.20854 3.83333C9.07846 3.83333 8.95362 3.85316 8.82937 3.87125C8.86962 3.73591 8.91104 3.59825 8.97754 3.47458C9.04404 3.29491 9.14787 3.13916 9.25112 2.98225C9.33746 2.8125 9.48971 2.69758 9.60171 2.55233C9.71896 2.41116 9.87879 2.31725 10.0054 2.2C10.1296 2.0775 10.2924 2.01625 10.4219 1.92991C10.5572 1.85233 10.675 1.76658 10.801 1.72575L11.1155 1.59625L11.392 1.48133L11.109 0.35083L10.7608 0.43483C10.6494 0.46283 10.5135 0.495496 10.3589 0.53458C10.2008 0.563746 10.0322 0.643663 9.84437 0.71658C9.65946 0.799997 9.44421 0.855413 9.24471 0.988997C9.04404 1.11616 8.81246 1.22233 8.60829 1.39266C8.41054 1.56825 8.17196 1.7205 7.99579 1.94333C7.80329 2.15216 7.61312 2.3715 7.46554 2.62116C7.29462 2.85916 7.17854 3.1205 7.05604 3.37891C6.94521 3.63733 6.85596 3.90158 6.78304 4.15825C6.64479 4.67275 6.58296 5.16158 6.55904 5.57983C6.53921 5.99866 6.55087 6.34691 6.57537 6.59891C6.58412 6.71791 6.60046 6.83341 6.61212 6.91333L6.62671 7.01133L6.64187 7.00783C6.74563 7.49248 6.98447 7.93786 7.33077 8.29243C7.67707 8.64701 8.11668 8.89631 8.59875 9.01148C9.08081 9.12665 9.58563 9.10299 10.0548 8.94323C10.524 8.78348 10.9384 8.49416 11.25 8.10874C11.5616 7.72333 11.7577 7.25757 11.8157 6.76534C11.8737 6.27311 11.7911 5.77452 11.5775 5.32726C11.364 4.88 11.0282 4.50233 10.6089 4.23796C10.1897 3.97358 9.70417 3.8333 9.20854 3.83333V3.83333Z"
							class="fill-emerald-100"></path></svg
					>
				</div>
			</div>
			<div class="group flex">
				<div
					class="animate__animated animate__rubberBand z-10 block rounded-md px-8 py-4 pr-6 md:border-r-8 md:border-[#2FAF83] md:bg-neutral-50 2xl:w-[600px] dark:bg-neutral-800"
				>
					<FormOption idForm="1" titleForm={SEO.title} client:load />
				</div>
				<Image
					class="hidden -translate-x-16 transition delay-150 duration-700 ease-in-out group-hover:translate-x-0 md:block"
					src={Grut}
					alt="grut"
					height={Grut.width / 2}
					width={Grut.height / 2}
				/>
			</div>
		</div>
	</section>
	<Section id="msubcat">
		<div class="mx-auto mb-12 max-w-4xl text-center lg:mb-24">
			<h2 class="text-balance" set:html={catCards.title} />
			<p class="pb-0 text-lg" set:html={catCards.description} />
		</div>
		<div class="flex flex-col justify-center lg:flex-row lg:flex-wrap">
			{
				MajorSubCategories.map((msubcat) => (
					<div class="mb-4 w-full lg:mx-4 lg:w-72">
						<Card title={msubcat.title} image={msubcat.image} link={msubcat.link} />
					</div>
				))
			}
		</div>
		<div class="mt-24">
			<FeaturesAddition
				title={featuresAddition.title}
				,
				text={featuresAddition.text}
				,
				additions={featuresAddition.additions}
			/>
		</div>
	</Section>
	<SidebarContent classes="bg-neutral-50 dark:bg-neutral-900">
		<div slot="sidebar">
			<h2 class="lg:text-2xl">Обрезка деревьев в Москве и МО</h2>

			<p class="mt-4">
				<i
					>Мечтаете о здоровом и ухоженном саде, радующем обильным урожаем? Закажите
					профессиональную обрезку деревьев у нас! Доверьтесь экспертам — ваш сад в надежных руках.</i
				>
			</p>
			<BtnLight link="/#" btnName="Заказать консультацию" />
		</div>
		<div class="basic-text">
			<p>
				Обрезка деревьев – это процесс частичного или полного удаления веток, который позволяет
				регулировать высоту дерева, формировать его крону, а также улучшать урожайность и качество
				плодов. Эта процедура способствует продлению жизни растения. Регулярная обрезка садовых
				деревьев ускоряет плодоношение и помогает создать правильную, эстетически привлекательную и
				хорошо вентилируемую крону. Обрезку рекомендуется проводить ежегодно, но важно соблюдать
				основные правила, чтобы не нанести вред деревьям.
			</p>
			<p>
				При обрезке деревьев важно учитывать возраст растения, его видовые особенности и текущее
				состояние. Для молодых деревьев проводят формирующую обрезку, которая задаёт направление
				роста и помогает избежать появления слабых или пересекающихся ветвей. Для взрослых деревьев
				акцент делают на санитарной и омолаживающей обрезке – удаляют сухие, поврежденные и больные
				ветви, чтобы предотвратить распространение инфекций и грибковых заболеваний.
			</p>
			<p>
				Обрезка должна выполняться в строго определённое время года. Оптимальным периодом считается
				поздняя зима или ранняя весна, до начала сокодвижения. Летняя обрезка допустима для
				санитарных целей, например, для удаления сломанных ветвей после сильного ветра.
				Использование правильных инструментов, таких как садовые ножницы, секаторы и пилы, также
				играет ключевую роль: они должны быть острыми и продезинфицированными, чтобы минимизировать
				риск заражения.
			</p>
			<p>
				Кроме того, после обрезки важно правильно обработать срезы. Для крупных ветвей рекомендуется
				использовать садовый вар или специальные пасты, чтобы защитить растение от грибков и
				насекомых. Не забывайте также про <a href="/podkormka-derevev">подкормку</a> и полив – эти меры
				помогут дереву быстрее восстановиться после процедуры.
			</p>
		</div>
	</SidebarContent>
	<SidebarContent>
		<div slot="sidebar">
			<h2 class="lg:text-2xl">Обрезка различных видов деревьев</h2>
			<BtnLight link="/#" btnName="Заказать консультацию" />
		</div>
		<div class="basic-text">
			<h3 class="lg:text-2xl">Обрезка яблони</h3>
			<p>
				Обрезка яблони, как правило, проводится весной, до начала сокодвижения. Процесс проходит
				поэтапно: вначале удаляют поврежденные и сломанные ветви, затем обрезают сухие, слабые или
				неправильно растущие побеги. Это помогает не только сформировать здоровую крону, но и
				способствует улучшению урожайности и качества плодов.
			</p>
			<h3 class="lg:text-2xl">Обрезка груши</h3>
			<p>
				Груша – светолюбивое дерево, поэтому обрезка играет ключевую роль в обеспечении доступа
				солнечного света к плодоносящим ветвям. Весенняя обрезка позволяет удалить загущенные
				участки кроны, стимулировать рост новых побегов и повысить общий уровень плодоношения. Также
				важно обращать внимание на состояние дерева, корректируя крону по мере необходимости.
			</p>
			<h3 class="lg:text-2xl">Слива и торнослив</h3>
			<p>
				Слива нуждается в регулярной обрезке, начиная с момента посадки саженца. Формирование кроны
				обычно продолжается до возраста 15 лет, после чего выполняются поддерживающие обрезки.
				Особое внимание уделяется удалению загущающих побегов и стимулированию ветвей, которые
				формируют прочный и сбалансированный каркас дерева.
			</p>
			<h3 class="lg:text-2xl">Обрезка вишни и черешни</h3>
			<p class="mt-2">
				Черешня обрезается для увеличения урожайности и улучшения общего состояния дерева. Основной
				акцент делается на развитии горизонтальных боковых ветвей, которые обеспечивают лучшую
				циркуляцию воздуха и доступ солнечного света. Тщательная и продуманная обрезка помогает не
				только увеличить количество плодов, но и формировать аккуратную, эстетичную крону, которая
				будет радовать долгие годы.
			</p>
		</div>
	</SidebarContent>

	<TextImage
		title="Методы и виды обрезки"
		text="<h3 class='lg:text-2xl'>Санитарная обрезка деревьев</h3><p class='mt-2'>Является одной из самых распространённых и важных процедур ухода. Она включает удаление засохших, повреждённых или поражённых болезнями веток. Такой подход позволяет предотвратить распространение инфекций и грибковых заболеваний, улучшить циркуляцию воздуха внутри кроны и сохранить общее здоровье дерева.</p><h3 class='lg:text-2xl'>Формовочная обрезка</h3><p class='mt-2'>Формовочная обрезка проводится для придания дереву определённой декоративной или функциональной формы. Чаще всего это чашеобразная, разреженно-ярусная или плоская форма кроны. Формирование кроны не только делает дерево эстетически привлекательным, но и способствует равномерному освещению всех ветвей, что положительно влияет на их развитие и плодоношение.</p><h3 class='lg:text-2xl'>Омолаживающая обрезка</h3><p class='mt-2'>Омолаживающая обрезка направлена на восстановление продуктивности старых или ослабленных деревьев. Эта процедура стимулирует образование новых плодоносящих ветвей, что позволяет дереву плодоносить ежегодно, а не с перерывами в несколько лет. Омолаживание особенно важно для садовых деревьев, где стабильный урожай играет ключевую роль.</p><h3 class='lg:text-2xl'>Корневая обрезка</h3><p class='mt-2'>Корневая обрезка – менее известный, но не менее значимый вид ухода. Она проводится для активизации роста плодовых почек и повышения урожайности. Регулирование корневой системы улучшает питание дерева, обеспечивая доступ к необходимым минералам и воде. Этот процесс особенно полезен для деревьев, которые сталкиваются с замедленным развитием или нерегулярным плодоношением.</p>"
		image={faqImage1}
		mobileImage={faqImage1}
		imagePosition="left"
		offsetImage
		classes="bg-neutral-50 dark:bg-neutral-900 lg:!py-32"
	/>
	<SidebarContent>
		<div slot="sidebar">
			<h2 class="lg:text-2xl">Сезонная обрезка</h2><p class="mt-4">
