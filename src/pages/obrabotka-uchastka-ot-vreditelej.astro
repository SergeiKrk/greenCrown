---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHero.astro'
import Feature from '../components/ui/Feature.astro'
import SidebarContent from '../components/blocks/basic/StickySidebar.astro'
import FAQ from '../components/blocks/FAQ/FaqSticky.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'
import Section from '../components/ui/Section.astro'
import Card from '../components/ui/cards/FeatureCard.astro'
import FormOption from '../components/ui/forms/form-option/FormOption.jsx'
import features from '../data/json-files/featuresData.json'
import ImageGallery from '../components/ui/ImageGallery.astro'

import heroImg from '../assets/obrabotka-uchastka-ot-vreditelej.png'
import ll1 from '../assets/obrabotka-ot-vreditelej-1.jpg'
import ll2 from '../assets/borba-s-krotami-na-uchastke-1.jpg'
import ll3 from '../assets/Treatment of the site from ticks.jpg'
import ll4 from '../assets/obrabotka-uchastka-ot-myshej-4.jpg'
import Grut from '../assets/Grut.webp'

import komarov from '../assets/obrabotka-ot-komarov.png'
import kleshchej from '../assets/obrabotka-ot-kleshchej.png'
import muravev from '../assets/obrabotka-ot-muravev.png'
import koroeda from '../assets/obrabotka-ot-koroeda.png'
import myshej from '../assets/obrabotka-ot-myshej.png'
import krys from '../assets/obrabotka-ot-krys.png'
import krotov from '../assets/obrabotka-ot-krotov.png'
// Data
import faqData from '../data/json-files/faqData.json'
// - FAQ Categories
const faqIntegrations = faqData.filter((faq) => faq.category === 'obrabotka-uchastka-ot-vreditelej')

// Content
import { Image } from 'astro:assets'
// - SEO
const SEO = {
	title: 'Уничтожение вредителей на участке – профессиональная обработка',
	description:
		'Комплексная дезинсекция и дератизация для частных домов, дач и участков. Безопасно для людей и животных!'
}
// - Page Header
const header = {
	title: 'Санитарная <strong>обработка участка</strong> от вредителей',
	text: ''
}

const catCards = {
	title: 'Услуги по обработке от <strong>вредителей</strong>',
	description: 'Комплексные услуги по борьбе с насекомыми, грызунами и паразитами.'
}

const catCardsTwo = {
	title: 'Когда дереву требуется <strong>лечение</strong>',
	description:
		'Ключевые признаки болезней, повреждений и наличия вредителей, когда требуется профессиональное вмешательство.'
}

type MajorSubCategories = {
	link: string
	title: string
	text?: string
	image: any
	imageWidth: number
	imageHeight: number
}

const MajorSubCategories: MajorSubCategories[] = [
	{
		link: '/obrabotka-ot-komarov',
		title: 'Обработка от комаров',
		image: komarov,
		imageWidth: komarov.width,
		imageHeight: komarov.height
	},
	{
		link: '/obrabotka-ot-kleshchej',
		title: 'Обработка от клещей',
		image: kleshchej,
		imageWidth: kleshchej.width,
		imageHeight: kleshchej.height
	},
	{
		link: '/obrabotka-ot-muravev',
		title: 'Обработка от муравьев',
		image: muravev,
		imageWidth: muravev.width,
		imageHeight: muravev.height
	},
	{
		link: '/obrabotka-ot-koroeda',
		title: 'Обработка от короеда',
		image: koroeda,
		imageWidth: koroeda.width,
		imageHeight: koroeda.height
	},
	{
		link: '/obrabotka-ot-myshey',
		title: 'Обработка от мышей',
		image: myshej,
		imageWidth: myshej.width,
		imageHeight: myshej.height
	},
	{
		link: '/obrabotka-ot-krys',
		title: 'Обработка от крыс',
		image: krys,
		imageWidth: krys.width,
		imageHeight: krys.height
	},
	{
		link: '/borba-s-krotami',
		title: 'Обработка от кротов',
		image: krotov,
		imageWidth: krotov.width,
		imageHeight: krotov.height
	}
]

const images = [
	{
		src: ll1,
		alt: 'Подкормка деревьев'
	},
	{
		src: ll2,
		alt: 'Подкормка деревьев удобрениями'
	},
	{
		src: ll3,
		alt: 'Подкормка удобрениями'
	},
	{
		src: ll4,
		alt: 'Подкормка почвы'
	}
]
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} heroImg={heroImg} />
	<section
		class="mt-42 mx-auto mb-6 max-w-[1200px] bg-neutral-100/80 p-6 2xl:mb-0 2xl:mt-12 2xl:bg-white"
		aria-multiselectable="false"
	>
		<div class="md:flex md:flex-row">
			<div class="text-slate-500 dark:text-slate-300">
				<div class="relative p-6 pb-0 pr-0">
					<figure class="relative z-10">
						<blockquote class="p-6 leading-relaxed">
							<p class="mb-2 text-sm font-light">
								<i>
									Санитарная обработка участка от вредителей — это надежное решение для защиты
									вашего дома, сада и огорода. Мы избавим вашу территорию от насекомых и грызунов,
									предотвращая их повторное появление</i
								>
							</p>
							<p class="mt-1">
								<span class="font-bold">Закажите бесплатную консультацию</span>
							</p>
						</blockquote>
					</figure><svg
						aria-hidden="true"
						class="absolute left-6 top-6 z-0 h-16 dark:hidden"
						viewBox="0 0 17 12"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						><path
