---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHeader.astro'
import SimpleFeed from '../components/blocks/feeds/BasicFeed.astro'
// import CTA from '../components/blocks/CTA/BasicLight.astro'

// Data
import feedData from '../data/json-files/changelogData.json'

// Content
// - SEO
const SEO = {
	title: 'Календарь садовых работ',
	description:
		'Сезонный календарь садовых работ: когда лечить, подкармливать и обрезать деревья для их здоровья и красоты'
}
// - Page Header
const header = {
	title: 'Садовый <strong>календарь</strong>',
	text: 'План садовых работ на год: советы по защите и уходу за деревьями и кустарниками'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<SimpleFeed data={feedData} />
	<!-- <CTA /> -->
</Layout>
