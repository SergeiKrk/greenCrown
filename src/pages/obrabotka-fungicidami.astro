---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHero.astro'
import SidebarContent from '../components/blocks/basic/StickySidebar.astro'
import FAQ from '../components/blocks/FAQ/FaqSticky.astro'
import TextImage from '../components/blocks/basic/TextImage.astro'
import CTA from '../components/blocks/CTA/BasicLight.astro'
import FormOption from '../components/ui/forms/form-option/FormOption.jsx'
import Feature from '../components/ui/Feature.astro'
import ImageGallery from '../components/ui/ImageGallery.astro'

import ll1 from '../assets/obrabotka-fungicidami-1.jpg'
import ll2 from '../assets/obrabotka-fungicidami-2.jpg'
import ll3 from '../assets/obrabotka-fungicidami-3.jpg'
import ll4 from '../assets/obrabotka-fungicidami-4.jpg'

import heroImg from '../assets/fungicidnaya-obrabotka.png'
import Grut from '../assets/Grut.webp'
// Data
import faqData from '../data/json-files/faqData.json'

import features from '../data/json-files/featuresData.json'
// - FAQ Categories
const faqIntegrations = faqData.filter((faq) => faq.category === 'obrabotka-fungicidami')

// Content
import obrabotkaNasekImg from '../assets/obrabotka-fungicidami-.jpg'
import { Image } from 'astro:assets'
import Steps from '../components/ui/Steps.astro'
import Certificates from '../components/blocks/Certificates.astro'
import FeedbackFormButton from '../components/ui/FeedbackFormButton.astro'
// - SEO
const SEO = {
	title: 'Обработка фунгицидами – Цены на услугу от 300 руб. за сотку',
	description:
		'Эффективная фунгицидная обработка сада, огорода и сельхозкультур. Профилактика и лечение грибковых болезней. Закажите профессиональную защиту растений!'
}
// - Page Header
const header = {
	title: 'Обработка участка <strong>фунгицидами</strong>',
	text: 'Проводим фунгицидную обработку деревьев, кустарников, овощей и злаков. Поможем защитить растения от болезней и грибков'
}
type steps = {
	title: string
	text?: string
}
const steps: steps[] = [
	{
		title: 'Выбор времени',
		text: 'Обработку лучше проводить ранней весной или осенью, когда растения еще не заболели. Также возможно проведение обработки летом, но важно делать это до появления симптомов болезни.'
	},
	{
		title: 'Совмещение с инсектицидами',
		text: 'Некоторые фунгициды можно сочетать с инсектицидами, но это не всегда возможно. Мы тщательно подбираем препараты, чтобы обеспечить максимальную эффективность и безопасность.'
	},
	{
		title: 'Подготовка инструментов',
		text: 'Для обработки потребуется опрыскиватель, защитные перчатки и маска. Все инструменты должны быть чистыми и готовыми к использованию.'
	},
	{
		title: 'Равномерное нанесение',
		text: 'Важно наносить фунгицид равномерно на растения: на листья, стебли и почву. Это обеспечит полноценную защиту.'
	}
]
const endstep = {
	title: 'Повторная обработка',
	text: 'Через 10–14 дней, в зависимости от типа фунгицида, может потребоваться повторное опрыскивание для продления действия препарата и защиты растений.'
}

const images = [
	{
		src: ll1,
		alt: 'Обработка участка фунгицидами'
	},
	{
		src: ll2,
		alt: 'фунгицидная обработка участка'
	},
	{
		src: ll3,
		alt: 'фунгицидная обработка'
	},
	{
		src: ll4,
		alt: 'фунгицидная обработка дачи'
	}
]
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} heroImg={heroImg} />
	<section
		class="mt-42 mx-auto mb-6 max-w-[1200px] bg-neutral-100/80 p-6 2xl:my-24 2xl:bg-white dark:bg-neutral-900"
		aria-multiselectable="false"
	>
		<div class="md:flex md:flex-row">
			<div class="text-slate-500 dark:text-slate-300">
				<div class="relative p-6 pb-0 pr-0">
					<figure class="relative z-10">
						<blockquote class="p-6 leading-relaxed">
							<p class="mb-2 text-sm font-light">
								<i>Профессиональная обработка деревьев и кустарников от грибковых заболеваний</i>
							</p>
							<p class="mt-1">
								<span class="font-bold">Закажите фунгицидную обработку сегодня</span> и получите план
								профилактических мер для вашего участка!
							</p>
						</blockquote>
					</figure><svg
						aria-hidden="true"
						class="absolute left-6 top-6 z-0 h-16 dark:hidden"
						viewBox="0 0 17 12"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						><path
							d="M2.79187 3.83333C2.66179 3.83333 2.53696 3.85316 2.41271 3.87125C2.45296 3.73591 2.49437 3.59825 2.56087 3.47458C2.62737 3.29491 2.73121 3.13916 2.83446 2.98225C2.92079 2.8125 3.07304 2.69758 3.18504 2.55233C3.30229 2.41116 3.46212 2.31725 3.58871 2.2C3.71296 2.0775 3.87571 2.01625 4.00521 1.92991C4.14054 1.85233 4.25837 1.76658 4.38437 1.72575L4.69879 1.59625L4.97529 1.48133L4.69237 0.35083L4.34412 0.43483C4.23271 0.46283 4.09679 0.495496 3.94221 0.53458C3.78412 0.563746 3.61554 0.643663 3.42771 0.71658C3.24221 0.799413 3.02754 0.855413 2.82804 0.988413C2.62737 1.11558 2.39579 1.22175 2.19162 1.39208C1.99387 1.56766 1.75529 1.71991 1.57912 1.94333C1.38662 2.15216 1.19646 2.3715 1.04887 2.62116C0.877957 2.85916 0.761873 3.1205 0.639373 3.37891C0.52854 3.63733 0.43929 3.90158 0.366373 4.15825C0.228123 4.67275 0.16629 5.16158 0.142373 5.57983C0.12254 5.99866 0.134207 6.34691 0.158707 6.59891C0.167457 6.71791 0.18379 6.83341 0.195457 6.91333L0.21004 7.01133L0.225207 7.00783C0.328959 7.49248 0.567801 7.93786 0.914102 8.29243C1.2604 8.64701 1.70001 8.89631 2.18208 9.01148C2.66415 9.12665 3.16897 9.10299 3.63815 8.94323C4.10733 8.78348 4.52169 8.49416 4.83331 8.10874C5.14493 7.72333 5.34107 7.25757 5.39903 6.76534C5.457 6.27311 5.37443 5.77452 5.16087 5.32726C4.94731 4.88 4.61149 4.50233 4.19225 4.23796C3.77302 3.97358 3.28751 3.8333 2.79187 3.83333V3.83333ZM9.20854 3.83333C9.07846 3.83333 8.95362 3.85316 8.82937 3.87125C8.86962 3.73591 8.91104 3.59825 8.97754 3.47458C9.04404 3.29491 9.14787 3.13916 9.25112 2.98225C9.33746 2.8125 9.48971 2.69758 9.60171 2.55233C9.71896 2.41116 9.87879 2.31725 10.0054 2.2C10.1296 2.0775 10.2924 2.01625 10.4219 1.92991C10.5572 1.85233 10.675 1.76658 10.801 1.72575L11.1155 1.59625L11.392 1.48133L11.109 0.35083L10.7608 0.43483C10.6494 0.46283 10.5135 0.495496 10.3589 0.53458C10.2008 0.563746 10.0322 0.643663 9.84437 0.71658C9.65946 0.799997 9.44421 0.855413 9.24471 0.988997C9.04404 1.11616 8.81246 1.22233 8.60829 1.39266C8.41054 1.5