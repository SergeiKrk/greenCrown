---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHero.astro'
import SidebarContent from '../components/blocks/basic/StickySidebar.astro'
import FAQ from '../components/blocks/FAQ/FaqSticky.astro'
import TextImage from '../components/blocks/basic/TextImage.astro'
import CTA from '../components/blocks/CTA/BasicLight.astro'
import FormOption from '../components/ui/forms/form-option/FormOption.jsx'
import Feature from '../components/ui/Feature.astro'
import ImageGallery from '../components/ui/ImageGallery.astro'

import heroImg from '../assets/obrabotka-ot-myshej.png'
import ll1 from '../assets/obrabotka-uchastka-ot-myshej-1.jpg'
import ll2 from '../assets/obrabotka-uchastka-ot-myshej-2.jpg'
import ll3 from '../assets/obrabotka-ot-vreditelej-2.jpg'
import ll4 from '../assets/obrabotka-uchastka-ot-myshej-4.jpg'
import Grut from '../assets/Grut.webp'
// Data
import faqData from '../data/json-files/faqData.json'

import features from '../data/json-files/featuresData.json'
// - FAQ Categories
const faqIntegrations = faqData.filter((faq) => faq.category === 'obrabotka-ot-myshey')

// Content
import obrabotkaNasekImg from '../assets/obrabotka-uchastka-ot-myshej.jpg'
import { Image } from 'astro:assets'
import Certificates from '../components/blocks/Certificates.astro'
import FeedbackFormButton from '../components/ui/FeedbackFormButton.astro'
// - SEO
const SEO = {
	title: 'Обработка дачи и участка от мышей – профессиональная защита зимой и летом',
	description:
		'Эффективное уничтожение мышей на даче, участке и в доме. Безопасные методы борьбы с гарантией. Узнайте цену!'
}
// - Page Header
const header = {
	title: 'Обработка от <strong>мышей</strong>',
	text: 'Профессиональная обработка дома и участка от мышей. Эффективное уничтожение грызунов с гарантией результата и доступными ценами.'
}
const images = [
	{
		src: ll1,
		alt: 'Обработка участка от мышей'
	},
	{
		src: ll2,
		alt: 'Обработка от мышей'
	},
	{
		src: ll3,
		alt: 'Борьба с мышами'
	},
	{
		src: ll4,
		alt: 'Борьба с мышами на участке'
	}
]
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} heroImg={heroImg} />
	<section
		class="mt-42 mx-auto mb-6 max-w-[1200px] bg-neutral-100/80 p-6 2xl:my-24 2xl:bg-white dark:bg-neutral-900"
		aria-multiselectable="false"
	>
		<div class="md:flex md:flex-row">
			<div class="text-slate-500 dark:text-slate-300">
				<div class="relative p-6 pb-0 pr-0">
					<figure class="relative z-10">
						<blockquote class="p-6 leading-relaxed">
							<p class="mb-2 text-sm font-light">
								<i>
									Обработка дачи и участка от мышей — надежная защита вашего дома и сада от
									грызунов, предотвращающая ущерб и создающая комфортные условия для жизни.
								</i>
							</p>
							<p class="mt-1">
								<span class="font-bold">Закажите уничтожение мышей сегодня</span> и получите рекомендации
								по защите вашего участка от грызунов на будущее!
							</p>
						</blockquote>
					</figure><svg
						aria-hidden="true"
						class="absolute left-6 top-6 z-0 h-16 dark:hidden"
						viewBox="0 0 17 12"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						><path
							d="M2.79187 3.83333C2.66179 3.83333 2.53696 3.85316 2.41271 3.87125C2.45296 3.73591 2.49437 3.59825 2.56087 3.47458C2.62737 3.29491 2.73121 3.13916 2.83446 2.98225C2.92079 2.8125 3.07304 2.69758 3.18504 2.55233C3.30229 2.41116 3.46212 2.31725 3.58871 2.2C3.71296 2.0775 3.87571 2.01625 4.00521 1.92991C4.14054 1.85233 4.25837 1.76658 4.38437 1.72575L4.69879 1.59625L4.97529 1.48133L4.69237 0.35083L4.34412 0.43483C4.23271 0.46283 4.09679 0.495496 3.94221 0.53458C3.78412 0.563746 3.61554 0.643663 3.42771 0.71658C3.24221 0.799413 3.02754 0.855413 2.82804 0.988413C2.62737 1.11558 2.39579 1.22175 2.19162 1.39208C1.99387 1.56766 1.75529 1.71991 1.57912 1.94333C1.38662 2.15216 1.19646 2.3715 1.04887 2.62116C0.877957 2.85916 0.761873 3.1205 0.639373 3.37891C0.52854 3.63733 0.43929 3.90158 0.366373 4.15825C0.228123 4.67275 0.16629 5.16158 0.142373 5.57983C0.12254 5.99866 0.134207 6.34691 0.158707 6.59891C0.167457 6.71791 0.18379 6.83341 0.195457 6.91333L0.21004 7.01133L0.225207 7.00783C0.328959 7.49248 0.567801 7.93786 0.914102 8.29243C1.2604 8.64701 1.70001 8.89631 2.18208 9.01148C2.66415 9.12665 3.16897 9.10299 3.63815 8.94323C4.10733 8.78348 4.52169 8.49416 4.83331 8.10874C5.14493 7.72333 5.34107 7.25757 5.39903 6.76534C5.457 6.27311 5.37443 5.77452 5.16087 5.32726C4.94731 4.88 4.61149 4.50233 4.19225 4.23796C3.77302 3.97358 3.28751 3.8333 2.79187 3.83333V3.83333ZM9.20854 3.83333C9.07846 3.83333 8.95362 3.85316 8.82937 3.87125C8.86962 3.73591 8.91104 3.59825 8.97754 3.47458C9.04404 3.29491 9.14787 3.13916 9.25112 2.98225C9.33746 2.8125 9.48971 2.69758 9.60171 2.55233C9.71896 2.41116 9.87879 2.31725 10.0054 2.2C10.1296 2.0775 10.2924 2.01625 10.4219 1.92991C10.5572 1.85233 10.675 1.76658 10.801 1.72575L11.1155 1.59625L11.392 1.48133L11.109 0.35083L10.7608 0.43483C10.6494 0.46283 10.5135 0.495496 10.3589 0.53458C10.2008 0.563746 10.0322 0.643663 9.84437 0.71658C9.65946 0.799997 9.44421 0.855413 9.24471 0.988997C9.04404 1.11616 8.81246 1.22233 8.60829 1.39266C8.41054 1.56825 8.17196 1.7205 7.99579 1.94333C7.80329 2.15216 7.61312 2.3715 7.46554 2.62116C7.29462 2.85916 7.17854 3.1205 7.05604 3.37891C6.94521 3.63733 6.85596 3.90158 6.78304 4.15825C6.64479 4.67275 6.58296 5.16158 6.55904 5.57983C6.53921 5.99866 6.55087 6.34691 6.57537 6.59891C6.58412 6.71791 6.60046 6.83341 6.61212 6.91333L6.62671 7.01133L6.64187 7.00783C6.74563 7.49248 6.98447 7.93786 7.33077 8.29243C7.67707 8.64701 8.11668 8.89631 8.59875 9.01148C9.08081 9.12665 9.58563 9.10299 10.0548 8.94323C10.524 8.78348 10.9384 8.49416 11.25 8.10874C11.5616 7.72333 11.7577 7.25757 11.8157 6.76534C11.8737 6.27311 11.7911 5.77452 11.5775 5.32726C11.364 4.88 11.0282 4.50233 10.6089 4.23796C10.1897 3.97358 9.70417 3.8333 9.20854 3.83333V3.83333Z"
							class="fill-emerald-100"></path></svg
					>
				</div>
			</div>
			<div class="group lg:flex">
				<div
					class="animate__animated animate__rubberBand z-10 block rounded-md px-8 py-4 pr-6 md:border-r-8 md:border-[#2FAF83] md:bg-neutral-50 2xl:w-[600px] dark:bg-neutral-800"
				>
					<FormOption idForm="1" titleForm={SEO.title} client:load />
				</div>
				<Image
					class="hidden -translate-x-16 transition delay-150 duration-700 ease-in-out group-hover:translate-x-0 md:block"
					src={Grut}
					alt="grut"
					height={Grut.width / 2}
					width={Grut.height / 2}
				/>
			</div>
		</div>
	</section>
	<SidebarContent classes="bg-neutral-50 dark:bg-neutral-900">
		<div slot="sidebar">
			<h2 class="lg:text-2xl">Травля мышей на даче</h2>
			<p class="mt-6">
				<i
					>Закажите профессиональную обработку участка от мышей и забудьте о вредителях раз и
					навсегда!</i
				>
			</p>
			<FeedbackFormButton
				titleBtnz="Заказать консультацию"
				idForm="2"
				titleForm=`${SEO.title}. Блок: Травля мышей на даче`
			/>
		</div>
		<div class="basic-text">
			<p>
				Мыши на даче – это не просто неудобство, а настоящая угроза для вашего здоровья и имущества.
				Эти маленькие, но опасные вредители могут разрушать здания, переносить болезни и доставлять
				массу других неприятностей. Мы предлагаем профессиональную обработку участка от мышей, чтобы
				избавиться от этих нежелательных гостей быстро и эффективно. Забудьте о мышах на даче и
				участке – с нами ваше пространство будет безопасным и чистым.
			</p>
		</div>
	</SidebarContent>
	<SidebarContent>
		<div slot="sidebar">
			<p class="lg:mt-14">
				<i>Оставьте заявку на уничтожение мышей и получите подробную консультацию бесплатно!</i>
			</p>
			<FeedbackFormButton
				titleBtnz="Заказать"
				idForm="3"
				titleForm=`${SEO.title}. Блок: Оставьте заявку на уничтожение мышей`
			/>
		</div>
		<div class="basic-text">
			<h3 class="lg:text-2xl">Услуги по уничтожению мышей</h3>
			<p>
				Наши специалисты проведут полный комплекс работ по уничтожению мышей на вашем участке. Мы
				используем современные методы, включая травлю мышей, установку ловушек и обработку
				специализированными средствами. С нами вы получите результат: мыши больше не будут
				беспокоить вас. Услуга эффективна не только от обычных мышей, но и от полевых мышей, которые
				часто встречаются на дачах и в садах. Мы гарантируем качество и безопасность всех
				применяемых средств.
			</p>
		</div>
	</SidebarContent>
	<TextImage
		title="Проблемы, связанные с мышами на даче"
		text='<p class="mt-2">Мыши на даче могут причинить немалый ущерб. Они не только портят пищу, но и разрушают мебель, стены и проводку.</p> <p class="mt-2">Мыши в доме на даче – это риск заболеваний, таких как лептоспироз, хантавирус и другие инфекционные болезни. Особенно опасны полевые мыши на участке, которые размножаются очень быстро и могут стать источником серьёзных проблем.</p> <p class="mt-2">Зима – время, когда мыши особенно активно ищут укрытия, и ваш дом или дача могут стать для них идеальным убежищем. Не дайте мышам шанс – примите меры уже сейчас!</p>'
		image={obrabotkaNasekImg}
		mobileImage={obrabotkaNasekImg}
		imagePosition="left"
		offsetImage
		classes="bg-neutral-50 dark:bg-neutral-900 lg:!py-32"
	/>
	<SidebarContent>
		<div slot="sidebar">
			<p class="mt-6">
				<i>
					Если народные средства оказались не такими эффективными, как вам хотелось бы, просто
					позвоните нам. - Мы избавим вас от мышей с гарантией!
				</i>
			</p>
			<FeedbackFormButton
				titleBtnz="Оставить заявку"
				idForm="4"
				titleForm=`${SEO.title}. Блок: Если народные средства оказались не такими эффективными`
			/>
		</div>
		<div class="basic-text lg:ml-4">
			<h3 class="lg:text-2xl">Методы борьбы с мышами</h3>
			<p>
				Чтобы избавиться от мышей на участке, важно использовать правильные методы. Мы применяем
				эффективные средства для травли мышей, которые уничтожают вредителей на всех стадиях их
				жизни. Ловушки и репелленты — тоже важная часть комплексного подхода. Для каждого случая мы
				подбираем индивидуальное решение, учитывая особенности участка и степень зараженности. Наши
				методы гарантируют, что мыши на вашем участке больше не будут проблемой.
			</p>
		</div>
	</SidebarContent>
	<SidebarContent classes="bg-neutral-50 dark:bg-neutral-900">
		<div slot="sidebar">
			<p class="mt-14">
				<i> Закажите обработку участка от мышей и защитите свой дом и сад от вредителей! </i>
			</p>
			<FeedbackFormButton
				titleBtnz="Заказать обработку"
				idForm="5"
				titleForm=`${SEO.title}. Блок: Закажите обработку участка от мышей`
			/>
		</div>
		<div class="basic-text">
			<h3>Ожидаемые результаты</h3>
			<p>
				После обработки участка от мышей, вы сразу заметите результат: вредители исчезнут, а ваш
				участок и дом останутся в безопасности. Мы гарантируем, что мыши больше не будут создавать
				проблемы, а долгосрочные результаты сохранятся. Все методы безопасны для вас и ваших
				домашних животных, а стоимость услуги вполне оправдана её качеством. С нами ваш дом станет
				чистым и защищённым.
			</p>
		</div>
	</SidebarContent>
	<!-- Features -->
	<SidebarContent>
		<div slot="sidebar">
			<h2 class="lg:text-2xl">Цены на обработку от мышей</h2>
			<p>
				Цена на обработку участка от мышей зависит от объема работы и выбранного метода. Мы
				предлагаем доступные цены с возможностью выбора подходящих вариантов по стоимости.
			</p>
			<FeedbackFormButton
				titleBtnz="Заказать обработку"
				idForm="6"
				titleForm=`${SEO.title}. Блок: Цены`
			/>
		</div>
		<div class="basic-text">
			<div class="w-full overflow-x-auto">
				<table
					class="w-full border-separate rounded border border-slate-200 text-left"
					cellspacing="0"
				>
					<tbody>
						<tr>
							<th
								scope="col"
								class="h-12 border-l bg-slate-100 stroke-slate-700 px-6 text-sm font-medium text-slate-700 first:border-l-0"
								>Площадь обработки</th
							>
							<th
								scope="col"
								class="h-12 min-w-[120px] border-l bg-slate-100 stroke-slate-700 px-6 text-sm font-medium text-slate-700 first:border-l-0"
								>Цена</th
							>
						</tr>
						<tr class="transition-colors duration-300 hover:bg-slate-50">
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>До 10 соток</td
							>
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>7500 ₽</td
							>
						</tr>
						<tr class="transition-colors duration-300 hover:bg-slate-50">
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>11 - 30 соток</td
							>
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>650 ₽/сотка</td
							>
						</tr>
						<tr class="transition-colors duration-300 hover:bg-slate-50">
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>31 - 50 соток</td
							>
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>630 ₽/сотка</td
							>
						</tr>
						<tr class="transition-colors duration-300 hover:bg-slate-50">
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>1 Га</td
							>
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>200 ₽/сотка</td
							>
						</tr>
						<tr class="transition-colors duration-300 hover:bg-slate-50">
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>от 3 Га</td
							>
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>120 ₽/сотка</td
							>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</SidebarContent>
	<div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
		<!-- Title -->
		<div class="mx-auto mb-8 max-w-2xl text-center lg:mb-14">
			<h2 class="text-pretty"><strong>Примеры</strong> выполненных работ</h2>
			<p class="pb-0 text-lg">Мы знаем и любим свое дело</p>
		</div>
		<!-- End Title -->

		<!-- Grid -->
		<div class="mx-auto grid max-w-3xl grid-cols-12 gap-6 lg:gap-8">
			{
				features.slice(0, 3).map((feature) => (
					<div class="col-span-6 text-center sm:col-span-4">
						<Feature title={feature.title} icon={feature.icon} align="center" classes="mb-12" />
					</div>
				))
			}
		</div>
		<!-- End Grid -->

		<ImageGallery images={images} />
	</div>
	<Certificates />
	<FAQ
		title="ЧаВо"
		text="Здесь мы собрали все самые популярные вопросу по теме обработки территории и помещений от мышей. Если у вас всё же останутся вопросы, оставьте заявку на консультацию ниже 👇."
		data={faqIntegrations}
	/>
	<CTA titleR="обработке участка и помещений от мышей" titleForm={SEO.title} />
</Layout>
