---
import Layout from '../layouts/Layout.astro'
import FormHero from '../components/blocks/hero/ContactHero.astro'
import ContactCards from '../components/blocks/contact/ContactCards.astro'
import Feature from '../components/blocks/features/FeatureList.astro'
import CTA from '../components/blocks/CTA/BasicLight.astro'
import BasicDark from '../components/blocks/testimonials/BasicDark.astro'
import testimonialBackground from '../assets/CEOspeech.webp'
import Contacts from '../components/blocks/hero/Contacts.astro'
import Certificates from '../components/blocks/Certificates.astro'

// Content
// - SEO
const SEO = {
	title: 'Контакты GREEN CROWN',
	description: 'Занимаемся лечением деревьев и кустарников, уходом за зелеными насаждениями'
}
// - Page Header
const header = {
	title: 'Мы <strong>GREEN</strong>CROWN (Зеленая крона)',
	text: 'Лечим деревья и кустарники, ухаживаем за зелеными насаждениями.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<FormHero
		title={header.title}
		text={header.text}
		id="contact"
		classes="bg-neutral-50 dark:bg-neutral-950/80"
	/>
	<Feature />
	<CTA titleR="уходу за зелеными насаждениями" titleForm={SEO.title} />
	<Certificates />
	<Contacts />
	<BasicDark bg={testimonialBackground} bgPosition="right" />
	<ContactCards classes="dark:bg-neutral-950/80" />
</Layout>
