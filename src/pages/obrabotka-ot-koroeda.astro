---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHero.astro'
import SidebarContent from '../components/blocks/basic/StickySidebar.astro'
import FAQ from '../components/blocks/FAQ/FaqSticky.astro'
import TextImage from '../components/blocks/basic/TextImage.astro'
import CTA from '../components/blocks/CTA/BasicLight.astro'
import FormOption from '../components/ui/forms/form-option/FormOption.jsx'
import Feature from '../components/ui/Feature.astro'
import ImageGallery from '../components/ui/ImageGallery.astro'

import heroImg from '../assets/obrabotka-ot-koroeda.png'
import Grut from '../assets/Grut.webp'
// Data
import faqData from '../data/json-files/faqData.json'

import features from '../data/json-files/featuresData.json'
// - FAQ Categories
const faqIntegrations = faqData.filter((faq) => faq.category === 'obrabotka-ot-koroeda')

// Content
import obrabotkaNasekImg from '../assets/obrabotka-derevev-ot-koroeda.jpg'
import ll1 from '../assets/obrabotka-derevev-ot-koroeda-1.jpg'
import ll2 from '../assets/obrabotka-derevev-ot-koroeda-2.jpg'
import ll3 from '../assets/obrabotka-derevev-ot-koroeda-3.jpg'
import ll4 from '../assets/obrabotka-derevev-ot-koroeda-4.jpg'
import { Image } from 'astro:assets'
import BtnLight from '../components/ui/BtnLight.astro'
import Certificates from '../components/blocks/Certificates.astro'
// - SEO
const SEO = {
	title: 'Обработка от короеда – профессиональное уничтожение жука короеда на участке',
	description:
		'Борьба с короедом: инъекции, обработка коры, химические препараты. Эффективное уничтожение жука короеда. Цены на обработку. Сохраним ваши деревья!'
}
// - Page Header
const header = {
	title: 'Обработка деревьев от <strong>короеда</strong>',
	text: 'Мы знаем, как бороться с жуком короедом. Эффективные препараты, защита деревьев на весь сезон.'
}
const images = [
	{
		src: ll1,
		alt: 'Обработка деревьев от короеда'
	},
	{
		src: ll2,
		alt: 'Обработка от короеда'
	},
	{
		src: ll3,
		alt: 'Борьба с короедом'
	},
	{
		src: ll4,
		alt: 'Борьба с жуком короедом'
	}
]
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} heroImg={heroImg} />
	<section
		class="mt-42 mx-auto mb-6 max-w-[1200px] bg-neutral-100/80 p-6 2xl:my-24 2xl:bg-white dark:bg-neutral-900"
		aria-multiselectable="false"
	>
		<div class="md:flex md:flex-row">
			<div class="text-slate-500 dark:text-slate-300">
				<div class="relative p-6 pb-0 pr-0">
					<figure class="relative z-10">
						<blockquote class="p-6 leading-relaxed">
							<p class="mb-2 text-sm font-light">
								<i
									>Обработка деревьев от короеда — это важный шаг для сохранения вашего сада,
									защищающий растения от разрушительных вредителей и продлевающий их жизнь.</i
								>
							</p>
							<p class="mt-1">
								<span class="font-bold">Закажите обработку деревьев от короеда сегодня </span> и получите
								рекомендации по уходу за зелеными насаждениями на вашем участке!
							</p>
						</blockquote>
					</figure><svg
						aria-hidden="true"
						class="absolute left-6 top-6 z-0 h-16 dark:hidden"
						viewBox="0 0 17 12"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						><path
							d="M2.79187 3.83333C2.66179 3.83333 2.53696 3.85316 2.41271 3.87125C2.45296 3.73591 2.49437 3.59825 2.56087 3.47458C2.62737 3.29491 2.73121 3.13916 2.83446 2.98225C2.92079 2.8125 3.07304 2.69758 3.18504 2.55233C3.30229 2.41116 3.46212 2.31725 3.58871 2.2C3.71296 2.0775 3.87571 2.01625 4.00521 1.92991C4.14054 1.85233 4.25837 1.76658 4.38437 1.72575L4.69879 1.59625L4.97529 1.48133L4.69237 0.35083L4.34412 0.43483C4.23271 0.46283 4.09679 0.495496 3.94221 0.53458C3.78412 0.563746 3.61554 0.643663 3.42771 0.71658C3.24221 0.799413 3.02754 0.855413 2.82804 0.988413C2.62737 1.11558 2.39579 1.22175 2.19162 1.39208C1.99387 1.56766 1.75529 1.71991 1.57912 1.94333C1.38662 2.15216 1.19646 2.3715 1.04887 2.62116C0.877957 2.85916 0.761873 3.1205 0.639373 3.37891C0.52854 3.63733 0.43929 3.90158 0.366373 4.15825C0.228123 4.67275 0.16629 5.16158 0.142373 5.57983C0.12254 5.99866 0.134207 6.34691 0.158707 6.59891C0.167457 6.71791 0.18379 6.83341 0.195457 6.91333L0.21004 7.01133L0.225207 7.00783C0.328959 7.49248 0.567801 7.93786 0.914102 8.29243C1.2604 8.64701 1.70001 8.89631 2.18208 9.01148C2.66415 9.12665 3.16897 9.10299 3.63815 8.94323C4.10733 8.78348 4.52169 8.49416 4.83331 8.10874C5.14493 7.72333 5.34107 7.25757 5.39903 6.76534C5.457 6.27311 5.37443 5.77452 5.16087 5.32726C4.94731 4.88 4.61149 4.50233 4.19225 4.23796C3.77302 3.97358 3.28751 3.8333 2.79187 3.83333V3.83333ZM9.20854 3.83333C9.07846 3.83333 8.95362 3.85316 8.82937 3.87125C8.86962 3.73591 8.91104 3.59825 8.97754 3.47458C9.04404 3.29491 9.14787 3.13916 9.25112 2.98225C9.33746 2.8125 9.48971 2.69758 9.60171 2.55233C9.71896 2.41116 9.87879 2.31725 10.0054 2.2C10.1296 2.0775 10.2924 2.01625 10.4219 1.92991C10.5572 1.85233 10.675 1.76658 10.801 1.72575L11.1155 1.59625L11.392 1.48133L11.109 0.35083L10.7608 0.43483C10.6494 0.46283 10.5135 0.495496 10.3589 0.53458C10.2008 0.563746 10.0322 0.643663 9.84437 0.71658C9.65946 0.799997 9.44421 0.855413 9.24471 0.988997C9.04404 1.11616 8.81246 1.22233 8.60829 1.39266C8.41054 1.56825 8.17196 1.7205 7.99579 1.94333C7.80329 2.15216 7.61312 2.3715 7.46554 2.62116C7.29462 2.85916 7.17854 3.1205 7.05604 3.37891C6.94521 3.63733 6.85596 3.90158 6.78304 4.15825C6.64479 4.67275 6.58296 5.16158 6.55904 5.57983C6.53921 5.99866 6.55087 6.34691 6.57537 6.59891C6.58412 6.71791 6.60046 6.83341 6.61212 6.91333L6.62671 7.01133L6.64187 7.00783C6.74563 7.49248 6.98447 7.93786 7.33077 8.29243C7.67707 8.64701 8.11668 8.89631 8.59875 9.01148C9.08081 9.12665 9.58563 9.10299 10.0548 8.94323C10.524 8.78348 10.9384 8.49416 11.25 8.10874C11.5616 7.72333 11.7577 7.25757 11.8157 6.76534C11.8737 6.27311 11.7911 5.77452 11.5775 5.32726C11.364 4.88 11.0282 4.50233 10.6089 4.23796C10.1897 3.97358 9.70417 3.8333 9.20854 3.83333V3.83333Z"
							class="fill-emerald-100"></path></svg
					>
				</div>
			</div>
			<div class="group lg:flex">
				<div
					class="animate__animated animate__rubberBand z-10 block rounded-md px-8 py-4 pr-6 md:border-r-8 md:border-[#2FAF83] md:bg-neutral-50 2xl:w-[600px] dark:bg-neutral-800"
				>
					<FormOption idForm="1" titleForm={SEO.title} client:load />
				</div>
				<Image
					class="hidden -translate-x-16 transition delay-150 duration-700 ease-in-out group-hover:translate-x-0 md:block"
					src={Grut}
					alt="grut"
					height={Grut.width / 2}
					width={Grut.height / 2}
				/>
			</div>
		</div>
	</section>
	<SidebarContent classes="bg-neutral-50 dark:bg-neutral-900">
		<div slot="sidebar">
			<h2 class="lg:text-2xl">Обработка от короеда</h2>
			<p class="mt-6">
				<i
					>Не откладывайте борьбу с короедом! Чем раньше начать обработку, тем выше шанс спасти
					дерево.
				</i>
			</p>
			<BtnLight link="/#" btnName="Заказать консультацию" />
		</div>
		<div class="basic-text">
			<h2 class="lg:text-2xl">Услуги по борьбе с короедом</h2>
			<p>
				Короед – это опасный вредитель, который уничтожает деревья изнутри. Он проникает под кору,
				оставляя дерево без питания. Если не принять меры вовремя, растение погибнет.
			</p>
			<p>
				Мы предлагаем профессиональные услуги по борьбе с короедом. Работаем с хвойными и плодовыми
				деревьями. Используем эффективные методы.
			</p>
		</div>
	</SidebarContent>
	<SidebarContent>
		<div slot="sidebar">
			<h2 class="lg:text-2xl">Уничтожение жука короеда</h2>
			<BtnLight link="/#" btnName="Заказать звонок" />
		</div>
		<div class="basic-text">
			<h3 class="lg:text-2xl">Как мы работаем:</h3>
			<ol>
				<li>Осматриваем дерево и выявляем очаг заражения.</li>
				<li>
					Подбираем метод борьбы: инъекции, обработка химическими средствами или механическая
					очистка.
				</li>
				<li>Проводим обработку, безопасную для дерева и окружающей среды.</li>
			</ol>
			<p>
				Не откладывайте борьбу с короедом! Чем раньше начать обработку, тем выше шанс спасти дерево.
			</p>
			<p>
				<i>Свяжитесь с нами прямо сейчас, чтобы получить консультацию и вызвать специалиста.</i>
			</p>
		</div>
	</SidebarContent>
	<TextImage
		title="Методы борьбы с короедом"
		text='<p class="mt-2">Короед – серьезная угроза для деревьев. Чтобы избавиться от вредителя, важно выбрать правильный метод. Мы применяем современные технологии, которые гарантируют результат.</p><h3 class="lg:text-2xl"><a href="/inekcii-derevyam">Инъекции в ствол</a></h3><p class="mt-2">Этот метод позволяет доставить препарат прямо в древесину. Инъекции уничтожают короеда изнутри и предотвращают повторное заражение. Это безопасно для дерева и окружающей среды.</p><h3 class="lg:text-2xl">Химическая обработка</h3><p class="mt-2">Препараты наносятся на поверхность коры. Они создают защитный барьер, который убивает короеда и его личинок. Метод подходит для хвойных и лиственных деревьев.</p><h3 class="lg:text-2xl">Механическая очистка</h3><p class="mt-2">Мы удаляем пораженные участки коры вручную. Этот способ позволяет быстро остановить распространение вредителя.</p><p class="mt-2">Правильно выбранный метод – залог спасения ваших деревьев. Мы подбираем решение индивидуально для каждого случая.</p>'
		image={obrabotkaNasekImg}
		mobileImage={obrabotkaNasekImg}
		imagePosition="left"
		offsetImage
		classes="bg-neutral-50 dark:bg-neutral-900 lg:!py-32"
	/>
	<SidebarContent>
		<div slot="sidebar">
			<p class="mt-6">
				<i> Оставьте заявку, чтобы получить консультацию и защитить деревья от короеда! </i>
			</p>
			<BtnLight link="/#" btnName="Оставить заявку" />
		</div>
		<div class="basic-text lg:ml-4">
			<h2 class="lg:text-2xl">Причины появления короеда</h2>
			<p>
				Короед поражает деревья, которые ослаблены болезнями или неблагоприятными условиями.
				Вредитель быстро размножается, уничтожая растение за несколько месяцев.
			</p>
			<p>Основные причины заражения:</p>
			<ul>
				<li>Ослабление дерева из-за недостатка влаги или питательных веществ.</li>
				<li>Повреждения коры после обрезки или механических ударов.</li>
				<li>Близость зараженных деревьев, особенно в хвойных лесах.</li>
			</ul>
		</div>
	</SidebarContent>
	<SidebarContent classes="bg-neutral-50 dark:bg-neutral-900">
		<div slot="sidebar">
			<p>
				<i>Не ждите, пока вредитель уничтожит дерево – закажите консультацию и защитите свой сад!</i
				>
			</p>
			<BtnLight link="/#" btnName="Заказать консультацию" />
		</div>
		<div class="basic-text">
			<h3 class="lg:text-2xl">Как предотвратить заражение короедом</h3>
			<ol>
				<li>
					Регулярно осматривайте деревья. При первых признаках – мелких отверстиях на коре или
					буровой пыли – обратитесь к специалисту.
				</li>
				<li>Ухаживайте за растениями: своевременно поливайте, удобряйте и проводите обрезку.</li>
				<li>Обрабатывайте деревья защитными препаратами. Это снизит риск появления вредителей.</li>
			</ol>
			<p>
				Короед – это серьезная угроза, но с ним можно справиться. Регулярная профилактика поможет
				сохранить здоровье ваших деревьев.
			</p>
		</div>
	</SidebarContent>
	<!-- Features -->
	<SidebarContent>
		<div slot="sidebar">
			<h2 class="lg:text-2xl">Цены на уничтожение жука короеда</h2>
			<p>
				Цены на обработку от короеда на участке зависят от количества деревьев и объема поражения.
			</p>
		</div>
		<div class="basic-text">
			<div class="w-full overflow-x-auto">
				<table
					class="w-full border-separate rounded border border-slate-200 text-left"
					cellspacing="0"
				>
					<tbody>
						<tr>
							<th
								scope="col"
								class="h-12 border-l bg-slate-100 stroke-slate-700 px-6 text-sm font-medium text-slate-700 first:border-l-0"
								>Наименование услуги</th
							>
							<th
								scope="col"
								class="h-12 border-l bg-slate-100 stroke-slate-700 px-6 text-sm font-medium text-slate-700 first:border-l-0"
								>ед.</th
							>
							<th
								scope="col"
								class="h-12 min-w-[120px] border-l bg-slate-100 stroke-slate-700 px-6 text-sm font-medium text-slate-700 first:border-l-0"
								>Цена, ₽</th
							>
						</tr>
						<tr class="transition-colors duration-300 hover:bg-slate-50">
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>Комплексное лечение деревьев. Оперативное опрыскивание 10-20 зараженных деревьев и
								кустарников</td
							>
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>Выезд бригады</td
							>
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>10 000</td
							>
						</tr>
						<tr class="transition-colors duration-300 hover:bg-slate-50">
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>Профилактика и лечение. В результате гарантированное здоровье и рост всех деревьев
								и кустарников</td
							>
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>Выезд бригады</td
							>
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>10 000</td
							>
						</tr>
						<tr class="transition-colors duration-300 hover:bg-slate-50">
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>Защита и стимуляция роста. Комплексное решение для лечения, профилактики и
								стимуляции роста деревьев и кустов.</td
							>
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>Выезд бригады</td
							>
							<td
								class="text-md border-l border-t border-slate-200 stroke-slate-500 px-6 py-4 text-slate-500 transition duration-300 first:border-l-0"
								>15 000</td
							>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</SidebarContent>
	<div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
		<!-- Title -->
		<div class="mx-auto mb-8 max-w-2xl text-center lg:mb-14">
			<h2 class="text-pretty"><strong>Примеры</strong> выполненных работ</h2>
			<p class="pb-0 text-lg">Мы знаем и любим свое дело</p>
		</div>
		<!-- End Title -->

		<!-- Grid -->
		<div class="mx-auto grid max-w-3xl grid-cols-12 gap-6 lg:gap-8">
			{
				features.slice(0, 3).map((feature) => (
					<div class="col-span-6 text-center sm:col-span-4">
						<Feature title={feature.title} icon={feature.icon} align="center" classes="mb-12" />
					</div>
				))
			}
		</div>
		<!-- End Grid -->

		<ImageGallery images={images} />
	</div>
	<Certificates />
	<FAQ
		title="ЧаВо"
		text="Здесь мы собрали все самые популярные вопросу по теме лечения деревьев от короеда. Если у вас всё же останутся вопросы, оставьте заявку на консультацию ниже 👇."
		data={faqIntegrations}
	/>
	<CTA titleR="обработке от короеда" titleForm={SEO.title} />
</Layout>
