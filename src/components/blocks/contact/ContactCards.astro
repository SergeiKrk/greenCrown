---
// Basic Cards grid Section
// ------------
// Description: A grid of cards with basic contact information in a 4 column layout.
// Properties:
// - classes: Additional classes to be added to the Section

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/BasicCard.astro'

// 	Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="requests" classes={classes}>
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-balance">Как мы можем <strong>помочь?</strong></h2>
			<p class="pb-0 text-lg">
				Компания GreenCrown — эксперт в уходе за зелеными насаждениями. Мы предоставляем полный
				комплекс услуг по уходу за деревьями, газонами и садовыми участками в Москве и Московской
				области.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="3">
			<Card
				title="Лечение деревьев"
				subtitle="Обследование и диагностика, лечение хвойных, лиственных и плодовых деревьев."
				icon="shield-check"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contact"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Защита деревьев"
				subtitle="Обработка от насекомых, вредителей и болезней, стволовые инъекции, каблинг."
				icon="bug-ant"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contact"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Обрезка деревьев"
				subtitle="Санитарная, формовочная, омолаживающая, кронирование"
				icon="chart-pie"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contact"
			/>
		</Col>
		<Col span="3" classes="flex flex-col gap-6">
			<Card
				title="Уход за садом"
				subtitle="Озеленение участка, посадка деревьев, подкормка и защита растений, уничтожение борщевика, аэрация почвы, фунгицидная обработка."
				icon="trophy"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contact"
			/>
		</Col>
	</Row>
</Section>
