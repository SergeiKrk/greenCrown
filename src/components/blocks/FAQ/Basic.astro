---
// Basic FAQ section
// ------------
// Description: A section that contains a list of frequently asked questions with answers.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Accordion from '../../ui/Accordion.astro'
import Card from '../../ui/cards/partials/Card.astro'

// Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="FAQ" classes={classes}>
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">
				Часто задаваемые <strong>вопросы</strong>
			</h2>
			<p class="text-lg leading-relaxed">
				Здесь мы собрали популярные вопросу по теме лечения и ухода за деревьями. Если у вас
				останутся вопросы, оставьте заявку на консультацию.
			</p>
			<a
				href="#"
				class="inline-flex h-8 items-center justify-center gap-2 whitespace-nowrap rounded border border-emerald-500 px-4 text-xs font-medium tracking-wide text-emerald-500 transition duration-300 hover:border-emerald-600 hover:text-emerald-600 focus:border-emerald-700 focus:text-emerald-700 focus-visible:outline-none disabled:cursor-not-allowed disabled:border-emerald-300 disabled:text-emerald-300 disabled:shadow-none"
			>
				<span>оставить Заявку</span>
			</a>
		</Col>
		<Col span="2" />
		<Col span="8">
			<Card classes="divide-y divide-neutral-100 dark:divide-neutral-800">
				<Accordion
					title="Что такое лесопатологическое обследование?"
					text="Это диагностика для выявления болезней, вредителей или факторов, угрожающих деревьям."
				/>
				<Accordion
					title="Как понять, что дерево нужно лечить?"
					text="Если вы заметили трещины в коре, дупла, усыхание ветвей или следы вредителей, это явные признаки того, что дерево нуждается в профессиональной помощи."
				/>
				<Accordion
					title="Когда лучше проводить лечение деревьев?"
					text="Всё зависит от проблемы. Например, весной важно проводить обработку перед началом активного сокодвижения, а осенью – обрезку и защиту от морозов."
				/>
				<Accordion
					title="Как спасти плодовые деревья от болезней?"
					text="Рекомендуется придерживаться определенных профилактических мер. Также придется протирать листья деревьев обеззараживающими и противогрибковыми препаратами. Обязательно требуется проводить обрезку веток, уборку листьев и т. д."
				/>
				<Accordion
					title="Как защитить дерево зимой?"
					text="Зимой важно оберегать деревья от морозобоин и механических повреждений. Мы предлагаем обвязку стволов и обработку защитными составами."
				/>
			</Card>
		</Col>
		<Col span="2" />
	</Row>
</Section>

<style>
	.page-header {
		@apply mx-auto max-w-3xl;
	}
	.page-header__text {
		@apply text-lg leading-relaxed;
	}
</style>
