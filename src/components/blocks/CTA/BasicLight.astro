---
// Basic Light Call To Action section
// ------------
// Description: A centered call to action section that contains: a title, text, a rating and a button.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import CTA from '../../ui/CTA.astro'
import Button from '../../ui/Button.astro'
import Ratings from '../../ui/Rating.astro'
import FormOption from '../../../components/ui/forms/form-option/FormOption.jsx'
---

<Section>
	<Row>
		<Col span="1" />
		<Col span="10">
			<CTA
				title="Получите консультацию по уходу за садом"
				text="Закажите бесплатную консультацию у специалистов по садоводству и лечению растений"
				classes="!shadow-none"
			>
				<Ratings rating={5} text="300+ довольных клиентов" classes="mb-4" />
				<div class="mt-2 max-w-[500px]">
					<FormOption idForm="1" titleForm="test" client:load />
					<!-- <FormOption idForm="1" titleForm={SEO.title} client:load /> -->
				</div>
			</CTA>
			<Col span="1" />
		</Col>
	</Row>
</Section>
