---
// Basic Light Call To Action section
// ------------
// Description: A centered call to action section that contains: a title, text, a rating and a button.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import CTA from '../../ui/CTA.astro'
import Ratings from '../../ui/Rating.astro'
import FormOption from '../../../components/ui/forms/form-option/FormOption.jsx'
type steps = {
	titleR: string
	titleForm: string
}
const { titleR, titleForm } = Astro.props
---

<Section>
	<Row>
		<Col span="1" />
		<Col span="10">
			<CTA
				title=`Получите консультацию по ${titleR}`
				text="Закажите бесплатную консультацию у специалистов по лечению растений и защите участка"
				classes="!shadow-none"
			>
				<Ratings rating={5} text="300+ довольных клиентов" classes="mb-4" />
				<div class="mt-2 max-w-[500px]">
					<FormOption idForm="7" titleForm={titleForm} client:load />
				</div>
			</CTA>
		</Col>
	</Row>
</Section>
