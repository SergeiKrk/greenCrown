---
// Contact Hero Section
// ------------
// Description: A hero section with a contact form

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
import { Image } from 'astro:assets'

import ce from '../../../assets/certificates/certificate-0.jpg'

// Props
type Props = {
	id?: string
	title?: string
	text?: string
	classes?: string
}
const { id, title, text, classes } = Astro.props
---

<Section id={id} classes={classes}>
	<div class="mx-auto max-w-5xl">
		<Row>
			<Col span="6" classes={`self-center`}>
				<Row>
					<Col span="12" classes={`self-center`}>
						<div
							class="transform rounded border bg-white p-5 shadow-sm duration-300 hover:-translate-y-2"
						>
							<div
								class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-green-100"
							>
								<svg
									fill="#2FAF83"
									viewBox="-12.3 -12.3 54.60 54.60"
									xmlns="http://www.w3.org/2000/svg"
									stroke="#2FAF83"
									stroke-width="0.00030000000000000003"
									><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g
										id="SVGRepo_tracerCarrier"
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke="#CCCCCC"
										stroke-width="0.06"></g><g id="SVGRepo_iconCarrier"
										><path
