---
import { Image } from 'astro:assets'
import wp from '../../assets/icons/icons8-whatsapp.gif'
import tg from '../../assets/icons/icons8-telegram.gif'
import call from '../../assets/icons/icons8-phone.gif'

type ElCall = {
	id: number
	title: string
	src: string
	img: ImageMetadata
}

const elcalls: ElCall[] = [
	{
		id: 1,
		title: 'WhatsApp',
		src: 'https://wa.me/79176261224',
		img: wp
	},
	{
		id: 2,
		title: 'Telegram',
		src: 'https://t.me/GREENCROVN',
		img: tg
	},
	{
		id: 3,
		title: 'Позвонить',
		src: 'tel:79176261224',
		img: call
	}
	// {
	//   id: 3,
	//   title: "Обратный звонок",
	//   src: '#',
	//   img: callback,
	// },
]
---

<!-- Component: Right sided fully rounded fab button with outside text -->
<div class="fixed bottom-12 right-12 z-50 lg:hidden">
	<span
		class="absolute z-10 mt-6 h-[48px] w-[48px] animate-ping rounded-full bg-green-400 opacity-80 hover:hidden"
	></span>
	<div class="group flex flex-col-reverse gap-2">
		<button
			class="group relative z-50 inline-flex h-12 items-center justify-center gap-2 self-center whitespace-nowrap rounded-full bg-green-700 px-6 text-sm font-medium tracking-wide text-white transition duration-300 hover:bg-green-600 focus:bg-green-700 focus-visible:outline-none disabled:cursor-not-allowed disabled:border-green-300 disabled:bg-green-300 disabled:shadow-none"
		>
			<span class="relative transition duration-300 only:-mx-6 group-hover:rotate-45">
				<span class="sr-only">Button description</span>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke-width="1.5"
					stroke="currentColor"
					class="h-5 w-5"
					aria-label="Plus icon"
				>
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
				</svg>
			</span>
		</button>
		{
			elcalls.map((el) => (
				<div class="relative h-0 opacity-0 group-hover:h-12 group-hover:opacity-100">
					<span class="absolute -start-32 top-0 mb-px flex h-0 items-center overflow-hidden rounded-full bg-green-100/70 px-4 text-sm font-bold text-green-700 opacity-0 transition delay-[0.1s] group-hover:h-12 group-hover:opacity-100">
						{el.title}
					</span>
					<a
						href={el.src}
						class="relative z-50 inline-flex h-0 w-0 translate-y-2 items-center justify-center gap-2 self-center justify-self-center whitespace-nowrap rounded-full bg-green-50 px-6 text-sm font-medium tracking-wide text-green-700 opacity-0 transition delay-[0.05s] duration-300 hover:bg-green-100 hover:text-green-600 focus:bg-green-200 focus:text-green-700 focus-visible:outline-none disabled:cursor-not-allowed disabled:border-green-300 disabled:bg-green-100 disabled:text-green-400 disabled:shadow-none group-hover:h-12 group-hover:w-12 group-hover:translate-y-0 group-hover:opacity-100"
					>
						<span class="relative only:-mx-6">
							<span class="sr-only">{el.title} button</span>
							<Image class="gb-white rounded-full p-2" src={el.img} alt={el.title} />
						</span>
					</a>
				</div>
			))
		}
	</div>
</div>
<!-- End Right sided fully rounded fab button with outside text -->
